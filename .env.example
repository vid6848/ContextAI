# Environment configuration
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# LLM Configuration (LiteLLM handles various providers: gemini, anthropic, openai, etc.)
MODEL_NAME=gemini-3.5-flash-lite
FALLBACK_MODEL_NAME=gemini-3.1-flash-lite
# Side tasks (titles, memory) use this model so they don't spend the chat model's per-minute quota
# (empty = the fallback model)
UTILITY_MODEL_NAME=
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Persistence & Storage
# Postgres connection string (Supabase: Project Settings -> Database -> Connection string -> Session pooler).
# When set, everything is stored there with pgvector; when empty, SQLite + ChromaDB under ./data are used.
DATABASE_URL=
SQLITE_DB_PATH=./data/contextai.db
CHROMA_PERSIST_DIR=./data/chroma

# External Tool API Keys
OPENWEATHER_API_KEY=your_openweather_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here


# Tool routing: hybrid (classifier when confident, otherwise the LLM picks and chains tools),
# llm (always function calling) or classifier (never)
ROUTER_MODE=hybrid
HYBRID_CONFIDENCE_THRESHOLD=0.8
MAX_TOOL_ROUNDS=4

# Long-term memory: llm (extract and reconcile facts after each reply) or heuristic (store raw messages)
MEMORY_MODE=llm

# Web Push for reminders (works with no tab open). Leave keys empty to auto-generate them into the
# data directory; set them in production so subscriptions survive redeploys.
PUSH_ENABLED=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:you@example.com

# Abuse protection
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=5
MAX_UPLOAD_MB=10
