# Environment configuration
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Backend API URL (used by Streamlit frontend)
BACKEND_API_URL=http://localhost:8000

# LLM Configuration (LiteLLM handles various providers: gemini, anthropic, openai, etc.)
MODEL_NAME=gemini-3.5-flash-lite
FALLBACK_MODEL_NAME=gemini-3.1-flash-lite
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Persistence & Storage
SQLITE_DB_PATH=./data/contextai.db
CHROMA_PERSIST_DIR=./data/chroma

# External Tool API Keys
OPENWEATHER_API_KEY=your_openweather_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

