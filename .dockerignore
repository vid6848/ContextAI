data/*
!data/.gitkeep
*.sqlite
*.sqlite3
*.db

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Frontend build inputs that are rebuilt inside the image
frontend/node_modules/
frontend/dist/
